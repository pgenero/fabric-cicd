		summarizeBy: none
		sourceColumn: observation_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column SP500
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
